{
  "grammars": [
    {
      "name": "lpc",
      "camelcase": "Lpc",
      "scope": "source.lpc",
      "path": ".",
      "file-types": [
        "c"
      ],
      "injection-regex": "lpc"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for LPC (LDMud flavor)",
    "authors": [
      {
        "name": "James Pickard"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-lpc"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
